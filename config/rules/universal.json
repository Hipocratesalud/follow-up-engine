  {
    "id": "short_treatment_followup",
    "version": "1.1.0",
    "layer": "universal",
    "description": "A short treatment (30 days or less, no refills, not a chronic drug class, not taken only when needed) should be followed by a visit within 3 days of its end. One control per consultation (the longest treatment); none when the note makes the return conditional ('reconsultar si persiste') or the doctor's plan already asks for a control by then.",
    "reason": { "code": "short_treatment_followup", "label": "Control al terminar el tratamiento" },
