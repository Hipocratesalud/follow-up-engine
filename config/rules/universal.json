[
  {
    "id": "lab_order_result_pending",
    "version": "1.0.0",
    "layer": "universal",
    "description": "A laboratory order should have a result within 15 days. A newer order of the same test supersedes it; a visit does not fulfill it.",
    "reason": { "code": "lab_order_result_pending", "label": "Resultado de laboratorio pendiente" },
    "trigger": { "event": "service_request.created", "filter": { "category": "laboratory" } },
    "dueInDays": 15,
    "expects": "lab",
    "caseGroup": "pending_results",
    "fulfilledBy": [
      { "event": "result.received", "match": "same_order" },
      { "event": "result.received", "match": "same_code" }
    ],
    "supersededBy": [
      {
        "event": "service_request.created",
        "filter": { "category": "laboratory" },
        "match": "same_code"
      }
    ],
    "priority": 40,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "contact_patient_pending_test",
      "label": "Contactar al paciente para completar el examen",
      "patientContactPurpose": "complete_pending_test"
    }
  },
