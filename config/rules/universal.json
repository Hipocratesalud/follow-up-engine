    "reason": { "code": "imaging_order_result_pending", "label": "Resultado de imagen pendiente" },
    "trigger": { "event": "service_request.created", "filter": { "category": "imaging" } },
    "dueInDays": 30,
    "expects": "imaging",
    "caseGroup": "pending_results",
    "fulfilledBy": [
      { "event": "result.received", "match": "same_order" },
      { "event": "result.received", "match": "same_code" }
    ],
    "supersededBy": [
      {
        "event": "service_request.created",
        "filter": { "category": "imaging" },
        "match": "same_code"
      }
    ],
    "priority": 50,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
