  {
    "id": "abnormal_result_followup",
    "version": "1.1.0",
    "layer": "universal",
    "description": "An abnormal result should be followed by a consultation within 7 days, unless it is at the target for a condition the patient is known to have (HbA1c below 8 % in a known diabetic) or a control is already planned by then.",
    "reason": {
      "code": "abnormal_result_followup",
      "label": "Resultado alterado sin consulta posterior"
    },
    "trigger": { "event": "result.received", "filter": { "interpretation": "abnormal" } },
    "resultTargets": [
      {
        "code": { "system": "http://loinc.org", "code": "4548-4" },
        "conditionCodes": ["E10", "E11", "E13", "E14"],
        "atTarget": { "gte": 4, "lt": 8 },
        "description": "HbA1c below 8 % is within the individualized goal of most adults with known diabetes (ADA Standards of Care); the lab flags anything >= 5.7 % as high."
      }
    ],
    "dueInDays": 7,
    "expects": "follow_up_visit",
    "caseGroup": "follow_up",
    "coveredByPlan": true,
    "fulfilledBy": [
      { "event": "encounter.finished", "match": "any" },
      { "event": "appointment.booked", "match": "any" }
    ],
    "priority": 60,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "review_results",
      "label": "Revisar el resultado con el paciente",
      "patientContactPurpose": "review_results"
    }
  }
]
