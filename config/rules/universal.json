  {
    "id": "short_treatment_followup",
    "version": "1.0.0",
    "layer": "universal",
    "description": "A short treatment (30 days or less) should be followed by a visit within 3 days of its end.",
    "reason": { "code": "short_treatment_followup", "label": "Control al terminar el tratamiento" },
    "trigger": { "event": "medication.prescribed", "filter": { "durationDays": { "lte": 30 } } },
    "dueInDays": 3,
    "dueFrom": "treatment_end",
    "expects": "follow_up_visit",
    "caseGroup": "follow_up",
    "fulfilledBy": [
      { "event": "encounter.finished", "match": "any" },
      { "event": "appointment.booked", "match": "any" }
    ],
    "priority": 30,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "schedule_follow_up",
      "label": "Agendar control de fin de tratamiento",
      "patientContactPurpose": "medication_review"
    }
  },
  {
    "id": "abnormal_result_followup",
    "version": "1.0.0",
    "layer": "universal",
    "description": "An abnormal result should be followed by a consultation within 7 days.",
    "reason": {
      "code": "abnormal_result_followup",
      "label": "Resultado alterado sin consulta posterior"
    },
    "trigger": { "event": "result.received", "filter": { "interpretation": "abnormal" } },
    "dueInDays": 7,
    "expects": "follow_up_visit",
    "caseGroup": "follow_up",
    "fulfilledBy": [
      { "event": "encounter.finished", "match": "any" },
      { "event": "appointment.booked", "match": "any" }
    ],
    "priority": 60,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "review_results",
      "label": "Revisar el resultado con el paciente",
      "patientContactPurpose": "review_results"
    }
  }
]
