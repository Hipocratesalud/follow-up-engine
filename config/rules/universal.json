  {
    "id": "lab_order_result_pending",
    "version": "1.1.0",
    "layer": "universal",
    "description": "A laboratory order should have a result within 15 days. A result of the same measurement under any equivalent LOINC code fulfills it (HbA1c 17856-6 or IFCC 59261-8 for a 4548-4 order; a lipid panel by its components). A newer order of the same test supersedes it (during a pregnancy, only in the same trimester: prenatal tests repeat by trimester); a visit does not fulfill it.",
    "reason": { "code": "lab_order_result_pending", "label": "Lab result pending" },
    "trigger": { "event": "service_request.created", "filter": { "category": "laboratory" } },
    "dueInDays": 15,
    "expects": "lab",
    "caseGroup": "pending_results",
    "fulfilledBy": [
      { "event": "result.received", "match": "same_order" },
      { "event": "result.received", "match": "same_code" }
    ],
    "supersededBy": [
      {
        "event": "service_request.created",
        "filter": { "category": "laboratory" },
        "match": "same_code"
      }
    ],
    "priority": 40,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "contact_patient_pending_test",
      "label": "Contact the patient to complete the test",
      "patientContactPurpose": "complete_pending_test"
    }
  },
