  {
    "id": "abnormal_result_followup",
    "version": "1.3.0",
    "layer": "universal",
    "description": "An abnormal result should be followed by a consultation within 7 days, unless it is at the target for a condition the patient is known to have (HbA1c below 8 % in a known diabetic, under any HbA1c LOINC code; an IFCC value in mmol/mol is converted, 8 % is about 64 mmol/mol) or a control is already planned by then. A booking by then counts whenever it was made, before the result included. The patient's stable level of a chronic marker (HbA1c no more than 0.5 points above the previous result in a known diabetic) is not a new finding: a visit with the ordering specialty booked or planned within 120 days is its follow-up. A critical result, a marker that got worse or a first abnormal value always expect the visit within 7 days.",
    "reason": {
      "code": "abnormal_result_followup",
      "label": "Abnormal result with no visit since"
    },
    "trigger": { "event": "result.received", "filter": { "interpretation": "abnormal" } },
    "resultTargets": [
      {
        "code": { "system": "http://loinc.org", "code": "4548-4" },
        "conditionCodes": ["E10", "E11", "E13", "E14"],
        "atTarget": { "gte": 4, "lt": 8 },
        "stableWithin": 0.5,
        "description": "HbA1c below 8 % is within the individualized goal of most adults with known diabetes (ADA Standards of Care); the lab flags anything >= 5.7 % as high. Results of any HbA1c LOINC code are read in % (IFCC mmol/mol through the IFCC-NGSP master equation, % = 0.0915 * mmol/mol + 2.15)."
      }
    ],
    "dueInDays": 7,
    "followUpWindowDays": 120,
    "expects": "follow_up_visit",
    "caseGroup": "follow_up",
    "coveredByPlan": true,
    "fulfilledBy": [
      { "event": "encounter.finished", "match": "any" },
      { "event": "appointment.booked", "match": "any" }
    ],
    "priority": 60,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "review_results",
      "label": "Review the result with the patient",
      "patientContactPurpose": "review_results"
    }
  }
]
