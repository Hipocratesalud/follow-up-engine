  {
    "id": "abnormal_result_followup",
    "version": "1.2.0",
    "layer": "universal",
    "description": "An abnormal result should be followed by a consultation within 7 days, unless it is at the target for a condition the patient is known to have (HbA1c below 8 % in a known diabetic, under any HbA1c LOINC code; an IFCC value in mmol/mol is converted, 8 % is about 64 mmol/mol) or a control is already planned by then.",
    "reason": {
      "code": "abnormal_result_followup",
      "label": "Abnormal result with no visit since"
    },
    "trigger": { "event": "result.received", "filter": { "interpretation": "abnormal" } },
    "resultTargets": [
      {
        "code": { "system": "http://loinc.org", "code": "4548-4" },
        "conditionCodes": ["E10", "E11", "E13", "E14"],
        "atTarget": { "gte": 4, "lt": 8 },
        "description": "HbA1c below 8 % is within the individualized goal of most adults with known diabetes (ADA Standards of Care); the lab flags anything >= 5.7 % as high. Results of any HbA1c LOINC code are read in % (IFCC mmol/mol through the IFCC-NGSP master equation, % = 0.0915 * mmol/mol + 2.15)."
      }
    ],
    "dueInDays": 7,
    "expects": "follow_up_visit",
    "caseGroup": "follow_up",
    "coveredByPlan": true,
    "fulfilledBy": [
      { "event": "encounter.finished", "match": "any" },
      { "event": "appointment.booked", "match": "any" }
    ],
    "priority": 60,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "review_results",
      "label": "Review the result with the patient",
      "patientContactPurpose": "review_results"
    }
  },
  {
    "id": "abnormal_imaging_followup_study",
    "version": "1.0.0",
    "layer": "universal",
    "description": "A report whose conclusion calls for a follow-up study expects that study by the date the finding calls for: BI-RADS 3 a short-interval study at 6 months, BI-RADS 0 additional imaging within 30 days, BI-RADS 4 or 5 a tissue diagnosis within 14 days, fetal biometry below the 10th percentile or growth restriction a growth scan with Doppler within 2 weeks (the conclusion is read with the engine's lexicon; ACR BI-RADS Atlas, 5th edition; ACOG Practice Bulletin 227). A result of the same study fulfills it; a new order of it replaces it and waits for its own result; a visit does not (that is abnormal_result_followup).",
    "reason": {
      "code": "abnormal_imaging_followup_study",
      "label": "Follow-up study the report recommends"
    },
    "trigger": {
      "event": "result.received",
      "filter": { "recommendedFollowUpDays": { "exists": true } }
    },
    "dueInDays": 180,
    "dueFrom": "recommended_follow_up",
    "expects": "imaging",
    "caseGroup": "follow_up",
    "fulfilledBy": [{ "event": "result.received", "match": "same_code" }],
    "supersededBy": [{ "event": "service_request.created", "match": "same_code" }],
    "priority": 60,
    "escalationPolicy": "default_v1",
    "suggestedAction": {
      "code": "order_follow_up_study",
      "label": "Order the follow-up study the report recommends",
      "patientContactPurpose": "complete_pending_test"
    }
  }
