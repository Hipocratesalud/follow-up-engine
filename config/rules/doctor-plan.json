    "id": "doctor_plan_followup",
    "version": "1.1.0",
    "layer": "doctor_plan",
    "description": "Each item of the follow-up plan the doctor wrote in a note (control visit, lab, imaging, session) is expected by the date the note gives. The item's own due date wins over dueInDays. What an acute episode asked for (the control of a sore throat, the urinalysis of a urinary infection) is no longer relevant once 90 days overdue, and a short control (45 days or less) of a visit that is not chronic care once 180 days overdue.",
    "reason": { "code": "doctor_plan_followup", "label": "Follow-up the doctor ordered" },
    "trigger": { "event": "plan.extracted" },
    "dueInDays": 30,
    "caseGroup": "follow_up",
    "fulfilledBy": [
      {
        "event": "encounter.finished",
        "match": "any",
        "forKinds": ["follow_up_visit", "session", "other"]
      },
      {
        "event": "appointment.booked",
        "match": "any",
        "forKinds": ["follow_up_visit", "session", "other"]
      },
      { "event": "result.received", "match": "same_code", "forKinds": ["lab", "imaging"] }
