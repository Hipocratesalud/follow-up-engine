      "everyDays": 90,
      "fulfilledBy": [
        {
          "event": "result.received",
          "filter": {
            "code.code": ["4548-4", "17856-6", "4549-2", "62388-4", "59261-8"]
          },
          "match": "any"
        }
      ],
      "planTerms": [
        "hba1c",
        "hb a1c",
        "a1c",
        "hemoglobina glicosilada",
        "hemoglobina glucosilada",
        "hemoglobina glicada",
        "glycated hemoglobin",
        "hemoglobin a1c"
      ],
      "priority": 40,
      "suggestedAction": {
        "code": "order_lab",
        "label": "Order HbA1c",
        "patientContactPurpose": "complete_pending_test"
      }
    },
    {
      "key": "lipids",
