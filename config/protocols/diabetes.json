{
  "id": "diabetes",
  "version": "1.2.1",
  "status": "ready_for_signoff",
  "description": "Diabetes mellitus follow-up: a control visit at least every 6 months, HbA1c every 3 months, lipid panel and fundus exam yearly. Fills only what the doctor's plan did not cover.",
  "reason": {
    "code": "protocol_diabetes",
    "label": "Diabetes follow-up"
  },
  "sources": [
    {
      "title": "Standards of Care in Diabetes—2025",
      "organization": "American Diabetes Association",
      "year": 2025,
      "url": "https://diabetesjournals.org/care/issue/48/Supplement_1"
    }
  ],
  "specialties": [
    "diabetology",
    "endocrinology",
    "internal_medicine",
    "general_practice",
    "family_medicine"
  ],
  "caseGroup": "follow_up",
  "enrollment": {
    "conditionCodes": ["E10", "E11", "E13", "E14"],
    "minimumStatus": "probable",
    "medications": [
      {
        "match": [
          "metformin",
          "insulin",
          "glibenclamid",
          "glimepirid",
          "gliclazid",
          "sitagliptin",
          "vildagliptin",
          "linagliptin",
          "empagliflozin",
          "dapagliflozin",
          "liraglutid",
          "semaglutid",
          "dulaglutid",
          "pioglitazon"
        ],
        "conditionCode": "E14"
      }
    ],
    "results": [
      {
        "code": {
          "system": "http://loinc.org",
          "code": "4548-4"
        },
        "gte": 6.5,
        "conditionCode": "E14"
      }
    ]
  },
  "items": [
    {
      "key": "visit",
      "kind": "follow_up_visit",
      "reason": {
        "code": "protocol_diabetes_visit",
        "label": "No diabetes visit in 6 months"
      },
      "everyDays": 180,
      "fulfilledBy": [
        {
          "event": "encounter.finished",
          "match": "any"
        },
        {
          "event": "appointment.booked",
          "match": "any"
        }
      ],
      "priority": 40,
      "suggestedAction": {
        "code": "schedule_follow_up",
        "label": "Schedule a diabetes visit",
        "patientContactPurpose": "schedule_follow_up"
      }
    },
    {
      "key": "hba1c",
      "kind": "lab",
      "code": {
