{
  "name": "@follow-up-engine/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker process (job runner, deadline and escalation sweeps, outbox delivery through signed webhooks) and the development webhook sink.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts",
    "webhook-sink": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/webhook-sink.ts"
  },
  "dependencies": {
    "@follow-up-engine/runtime": "workspace:*",
    "@hono/node-server": "^2.1.5"
  }
}
