  "personaConfig": [
    {
      "id": "fast_responder",
      "weight": 0.3,
      "summary": "Replies to the first message and takes the first slot that fits.",
      "rationale": "ASSUMPTION: the largest group. Most patients who read a message from their own clinic answer it, and many of them would have done the order anyway (high self-completion)."
    },
    {
      "id": "second_try",
      "weight": 0.15,
      "summary": "Misses the first message, answers a later one.",
      "rationale": "ASSUMPTION: busy patients who read messages late; a second contact several days later is what gets an answer."
    },
    {
      "id": "slot_friction",
      "weight": 0.12,
      "summary": "Answers, but the offered time never suits them (\"not Tuesday\", only Saturdays).",
      "rationale": "ASSUMPTION: working patients for whom weekday mornings do not work; they book when the time changes, and rarely find a time on their own after a generic reminder."
    },
    {
      "id": "wrong_number",
      "weight": 0.06,
      "summary": "The phone on file is wrong: messages are undelivered until reception fixes it.",
      "rationale": "ASSUMPTION: outdated or mistyped numbers. Once the right number is found they behave like an average patient."
