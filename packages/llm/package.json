{
  "name": "@follow-up-engine/llm",
  "version": "0.0.0",
  "private": true,
  "description": "llm_gateway and LLM provider adapters (Meta, OpenAI-compatible, fake).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "eval:extraction": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings=ExperimentalWarning src/eval/cli.ts",
    "eval:compare": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/eval/compare.ts"
  },
  "dependencies": {
    "@follow-up-engine/core": "workspace:*",
    "zod": "^4.6.7"
  }
}
