{
  "name": "follow-up-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone clinical follow-up engine. FHIR R4 in and out, hexagonal core, Meta models behind a single llm_gateway.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=4 run typecheck",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs --output-type err-long",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @follow-up-engine/api e2e",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
