# Copy to .env and adjust. Never commit real keys.

# Postgres connection (docker compose up -d postgres). Vanilla Postgres or Supabase.
# Unset: in-memory storage (demo only, lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/follow_up_engine
# Schema of the engine tables (default follow_up).
DATABASE_SCHEMA=

# LLM provider behind llm_gateway: meta | baseten | openai-compatible | fake
LLM_PROVIDER=fake
# Meta Model API key (Muse Spark) and model (default muse-spark-1.3).
META_API_KEY=
META_MODEL=
# Baseten API key (Muse Spark Open) and model (default meta-models/muse-spark-open).
BASETEN_API_KEY=
BASETEN_MODEL=
# Any OpenAI-compatible endpoint, with its price (USD per 1M tokens) for budgets.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_PRICE_IN_PER_MTOK=
OPENAI_COMPATIBLE_PRICE_OUT_PER_MTOK=

# Host EHR webhook that receives case events, and the HMAC secret used to sign them.
# Unset WEBHOOK_URL: events go to an in-process signed sink (demo).
WEBHOOK_URL=http://localhost:4000/webhooks/follow-up-engine
WEBHOOK_SECRET=
# Where the demo endpoint reads deliveries when the sink runs as its own process.
WEBHOOK_SINK_URL=http://localhost:4000

# Clock adapter: system | fake (fake starts at FAKE_CLOCK_START and enables /api/demo).
CLOCK=system
FAKE_CLOCK_START=2026-01-05T12:00:00Z

# API key of the synthetic demo clinic `clinic-demo` (registered at startup when set).
DEMO_API_KEY=

# API process.
PORT=3000
# Run the worker inside the API process (single-container deployments, demo).
EMBEDDED_WORKER=false
# Browser origins allowed to call the API (the inbox).
CORS_ORIGINS=http://localhost:5173

# Worker loop intervals (milliseconds).
WORKER_POLL_MS=1000
OUTBOX_POLL_MS=2000
SWEEP_INTERVAL_MS=3600000

LOG_LEVEL=info
