# Copy to .env and adjust. Never commit real keys.

# Postgres connection (docker compose up -d postgres). Vanilla Postgres or Supabase.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/follow_up_engine

# LLM provider behind llm_gateway: meta | baseten | openai-compatible | fake
LLM_PROVIDER=fake
# Meta Model API key (Muse Spark).
META_API_KEY=
# Baseten API key (Muse Spark Open, meta-models/muse-spark-open-1026).
BASETEN_API_KEY=

# Host EHR webhook that receives case events, and the HMAC secret used to sign them.
WEBHOOK_URL=http://localhost:4000/webhooks/follow-up-engine
WEBHOOK_SECRET=

# Clock adapter: system | fake (fake starts at a fixed instant, for demos and evals).
CLOCK=system
